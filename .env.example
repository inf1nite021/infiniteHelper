# Aus dem Partner-Dashboard
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://infinite-helper.infinitecodes.de
SCOPES=read_script_tags,read_themes,read_shipping,read_fulfillments,read_discounts,read_products

# Dieselbe Datenbank wie die uebrigen Apps; die Tabellen stehen unter
# Row-Level Security je Shop.
DATABASE_URL=postgres://BENUTZER:PASSWORT@postgres-db:5432/preis_checker_db
DIRECT_URL=postgres://BENUTZER:PASSWORT@postgres-db:5432/preis_checker_db

# Wohin die Anfrage geht: derselbe Endpunkt wie beim Support-Formular der
# uebrigen Apps, der daraus ein Zammad-Ticket macht.
SUPPORT_ENDPOINT=https://infinitecodes.de/api/kontakt
SUPPORT_APP_TOKEN=
